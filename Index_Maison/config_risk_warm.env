# Risk WARM — constantes (pas de genesis / pas de masses ACE)
# Source pour Risk Guardian + C7. Lecture seule côté hot path.
#
# Usage:
#   set -a; source Index_Maison/config_risk_warm.env; set +a

# C7 — drawdown combiné ACE + Hulk (paper/testnet) → alerte / kill soft
# 8% = défaut validé 2026-07-30 (assez bas pour survivre, pas panique)
export MAX_GLOBAL_DD_PCT="${MAX_GLOBAL_DD_PCT:-8}"

# Fichier alerte Cortana urgence (P3) — contrat swarm /tmp
# Consommé (unlink) après say ; archive = Index_Maison/thermo/.urgent_alert.last.json
export ACE777_URGENT_ALERT="${ACE777_URGENT_ALERT:-/tmp/ace777_swarm_pids/.urgent_alert.json}"

# Cortana TTS (edge neuronal)
export EDGE_TTS_VOICE="${EDGE_TTS_VOICE:-fr-FR-VivienneMultilingualNeural}"
export EDGE_TTS_RATE="${EDGE_TTS_RATE:-+5%}"
export CORTANA_TTS="${CORTANA_TTS:-auto}"
