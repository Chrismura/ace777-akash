<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ace777.flux-nets</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Developer/CommandLineTools/usr/bin/python3</string>
        <string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/flux_nets_exchanges.py</string>
        <string>--silencieux</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/flux_nets_launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/flux_nets_launchd.err.log</string>
</dict>
</plist>
