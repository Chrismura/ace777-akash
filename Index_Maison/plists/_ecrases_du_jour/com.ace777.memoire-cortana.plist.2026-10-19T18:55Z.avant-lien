<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTD/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ace777.memoire-cortana</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/memoire_cortana_soir.py</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>23</integer>
		<key>Minute</key>
		<integer>50</integer>
	</dict>
	<key>StandardErrorPath</key>
	<string>/tmp/memoire_cortana_launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/memoire_cortana_launchd.out.log</string>
</dict>
</plist>
