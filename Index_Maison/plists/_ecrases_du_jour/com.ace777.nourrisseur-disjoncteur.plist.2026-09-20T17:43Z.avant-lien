<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ace777.nourrisseur-disjoncteur</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/nourrir_disjoncteur.py</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Second</key>
        <integer>30</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/nourrisseur_disjoncteur.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/nourrisseur_disjoncteur.err.log</string>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
