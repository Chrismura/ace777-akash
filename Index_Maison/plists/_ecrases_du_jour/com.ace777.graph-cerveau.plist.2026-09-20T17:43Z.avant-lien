<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ace777.graph-cerveau</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/rebuild_graph.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/graph_cerveau.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/graph_cerveau.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>11</integer>
		<key>KeepAlive</key>
		<true/>
		<key>Minute</key>
		<integer>30</integer>
		<key>RunAtLoad</key>
		<true/>
	</dict>
</dict>
</plist>
