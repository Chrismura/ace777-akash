<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ace777.cortana-analyzer</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/cortana_analyzer.py</string>
	</array>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>/tmp/cortana_analyzer_launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/cortana_analyzer_launchd.out.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
