<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ace777.prise-ia</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/christophe/prise-ia/hub_prise_ia.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/christophe/prise-ia</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/christophe/prise-ia/hub.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/christophe/prise-ia/hub.err.log</string>
</dict>
</plist>
