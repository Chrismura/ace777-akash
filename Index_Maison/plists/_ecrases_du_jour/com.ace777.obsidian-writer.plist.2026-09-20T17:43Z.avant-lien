<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ace777.obsidian-writer</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/obsidian_writer.py</string>
		<string>--scan</string>
		<string>--age-heures</string>
		<string>24</string>
	</array>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/obsidian_writer.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/obsidian_writer.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/christophe/ace777-test-day1/Index_Maison/scripts</string>
</dict>
</plist>
