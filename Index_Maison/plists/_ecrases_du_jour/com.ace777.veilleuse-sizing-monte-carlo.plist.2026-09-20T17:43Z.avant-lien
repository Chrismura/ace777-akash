<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.ace777.veilleuse-sizing-monte-carlo</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/veilleuse_sizing_monte_carlo.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/veilleuse-sizing-monte-carlo.err.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/veilleuse-sizing-monte-carlo.log</string>
	<key>StartInterval</key>
	<integer>21600</integer>
</dict>
</plist>
