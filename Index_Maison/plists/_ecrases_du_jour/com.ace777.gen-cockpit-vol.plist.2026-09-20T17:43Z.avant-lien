<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ace777.gen-cockpit-vol</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/gen_cockpit_vol.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardErrorPath</key><string>/tmp/gen_cockpit_vol.err.log</string>
  <key>StandardOutPath</key><string>/tmp/gen_cockpit_vol.out.log</string>
</dict>
</plist>
