<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ace777.llm-gate-hub</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/llm_gate_hub_bridge.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/christophe/ace777-test-day1/Index_Maison/scripts</string>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/llm_gate_hub.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/llm_gate_hub.err.log</string>
</dict>
</plist>
