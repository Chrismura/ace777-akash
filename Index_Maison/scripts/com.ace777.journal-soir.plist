<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Journal hygiène agora — 20:53 heure locale, tous les jours. Pas de trading. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ace777.journal-soir</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/journal_soir_launchd.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>20</integer>
    <key>Minute</key>
    <integer>53</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/logs/launchd_journal_soir.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/christophe/ace777-test-day1/Index_Maison/scripts/logs/launchd_journal_soir.err</string>
</dict>
</plist>
