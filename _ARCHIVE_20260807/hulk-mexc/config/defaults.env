# Seuils inventaire / paper (pas de secrets ici)
WATCHLIST_URL=https://coinmarketcap.com/watchlist/68f096217962d710267cb472/
WATCHLIST_NAME=The_Hulk_Crypto_Portfolio_Picks

# Liquidité MEXC spot USDT
MIN_QUOTE_VOL_USDT=50000
MAX_SPREAD_BPS=80

# Paper v1.4 — pleine mise
NOTIONAL_USDT=20
# Realisme baissier : au démarrage, déjà ~20$ en tokens (paper) pour pouvoir VENDRE
SEED_ON=1
# Inventaire paper pour tester les VENTES baissières (~20$ en tokens).
# Ce n’est PAS le capital de trading (NOTIONAL_USDT=20 reste à part).
SEED_USDT=20
# split = répartir sur N paires ; single = 1 seule paire
SEED_MODE=split
# IMPORTANT : ne PAS mettre 15 ici — sinon 20$/15 ≈ 1.33$ et les fonds fondent.
# Univers suivi = 15 (PAPER_PAIRS) ; seed inventaire = 2 paires liquides (~10$ chacune).
SEED_MAX_PAIRS=2
POLL_SEC=20
SCORE_EVERY=3
# Veille LIVE : live = enchaîne les scans sans pause (délai = durée scan MEXC).
# Écrit VEILLE_ALERT seulement si signal nouveau.
DIGEST_LOOP_SEC=live
# Dédup : 1 écriture max / paire:type de hint par heure (VEILLE_CALLS / notes)
HINT_COOLDOWN_SEC=3600

# Régimes (15j / impulse) — strict : pas de micro-dips
QUIET_RANGE_PCT=8
SPIKE_15D_PCT=25
IMPULSE_PCT=8
COOLING_DD_MIN_PCT=8
COOLING_PULLBACK_FRAC=0.28
IMPULSE_PULLBACK_MIN_PCT=5
IMPULSE_PULLBACK_FRAC=0.30

# Cadence → seuils (floors + mult × cadence journalière médiane)
DIP_FLOOR_PCT=4.0
RIP_FLOOR_PCT=2.0
STOP_FLOOR_PCT=6.0
DIP_CADENCE_MULT=0.50
RIP_CADENCE_MULT=0.35
STOP_CADENCE_MULT=0.80

# === Logique mise → 2× → bag (plus de bag 15%) ===
# Mise 20$ → quand la position vaut 40$ (2×) → vend 50% (récupère ~mise)
# Reste = BAG maison (plus-value)
STAKE_DOUBLE_MULT=2.0
STAKE_SELL_FRAC=0.50

# Bag maison
BAG_DCA_ON=1
BAG_SLOW_DD_PCT=8
BAG_DCA_DD_PCT=6
BAG_DCA_TTL_SEC=86400
BAG_CRASH_DD_PCT=20
BAG_CRASH_SELL_FRAC=0.90

# Cash récupéré → redeploy 100% si dip (COOLING/IMPULSE)
CASH_REDEPLOY_ON=1

# Volume sniffer (priorité small-caps)
VOL_SMALL_CAP_USDT=400000
VOL_SMALL_CADENCE=12
VOL_SPIKE_MIN_SMALL=1.5
VOL_HOT_SPIKE=2.0
VOL_OK_SPIKE=1.3
VOL_DRY_SPIKE=0.8

# Compound : PnL réalisé grossit la taille des prochains trades
COMPOUND_ON=1
COMPOUND_FRAC=0.50
COMPOUND_MAX_MULT=3.0

# Re-entry : après SELL stop, racheter si dump
REENTRY_ON=1
REENTRY_DD_PCT=6
REENTRY_TTL_SEC=7200

# v1.5 — anti-reentry dur (cache stops) + skip RED veille (soft)
STOP_COOLDOWN_HOURS=2
VEILLE_SKIP_RED_ON=1
VEILLE_STATUS_MAX_AGE_MIN=30
VEILLE_STATUS_REFRESH_SEC=60

# Capteurs style ACE (MEXC book) — pas le genesis
SENSE_ON=1
SENSE_MAX_SPREAD_BPS=80
SENSE_MAX_SPREAD_BPS_SPIKE=400
SENSE_MIN_DEPTH_USDT=80
SENSE_MIN_TENSION=1.2
SENSE_MAX_ASK_WALL_RATIO=8
SENSE_STRICT_TENSION=1

# Univers paper
PAPER_PAIRS=XRPUSDT,HBARUSDT,QAITUSDT,RIZEUSDT,ZBCNUSDT,WUSDT,REDUSDT,CCUSDT,PYTHUSDT,BIOUSDT,KITEUSDT,TELUSDT,CHIPUSDT,RWAINCUSDT,EDELUSDT
PAPER_WATCH_PAIRS=QNTUSDT,FLUIDUSDT,RWAUSDT
