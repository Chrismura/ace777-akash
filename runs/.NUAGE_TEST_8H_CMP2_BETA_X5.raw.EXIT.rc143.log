      /^[[:space:]]*raw_qty="\$\(num_div/ && !gate_done {
        print "  if duo_is_hunter; then"
        print "    nuage_cloud_tension_gate \"$i\" || { alpha_touch_heartbeat; sleep \"$SLEEP_SEC\"; continue; }"
        print "  fi"
        gate_done=1
