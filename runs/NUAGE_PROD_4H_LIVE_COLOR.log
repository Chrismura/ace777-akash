[BETA_X5] nuage_cloud_tension_gate() {
[BETA_X5]   local cycle="$1"
[BETA_X5]   local max_age="${NUAGE_TENSION_MAX_AGE_MS:-800}"
[BETA_X5]   local age_ms path
[BETA_X5]   duo_is_hunter || return 0
[BETA_X5]   path="${DUO_STATE_FILE:-runs/duo_state.json}"
[BETA_X5]   age_ms="$(ruby -rjson -e '
[BETA_X5]     path = ARGV[0]
[BETA_X5]     begin
[BETA_X5]       j = JSON.parse(File.read(path))
[BETA_X5]       ts = (j["ts_ms"].to_i rescue 0)
[BETA_X5]       age = ((Time.now.to_f * 1000).to_i - ts)
[BETA_X5]       age = 0 if age < 0
[BETA_X5]       print(age)
[BETA_X5]     rescue
[BETA_X5]       print(999999)
[BETA_X5]     end
