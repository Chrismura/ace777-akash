duo_global_stop_hit() {
  duo_enabled || return 1
  if ! num_lt "$DUO_GLOBAL_STOP_SESSION_USDT" "0"; then
    return 1
  fi
  local total
  total="$(duo_session_total_pnl)"
  if num_le "$total" "$DUO_GLOBAL_STOP_SESSION_USDT"; then
    if [ "$DUO_GLOBAL_STOP_HALT_RUN" = "TRUE" ]; then
      touch "$STOP_FILE" STOP STOP_ALPHA STOP_BETA 2>/dev/null || true
      echo "GLOBAL STOP hit (HALT) | total_pnl=$total <= $DUO_GLOBAL_STOP_SESSION_USDT"
      return 0
    fi
    echo "GLOBAL STOP hit (NON-BLOCKING) | total_pnl=$total <= $DUO_GLOBAL_STOP_SESSION_USDT"
    return 1
  fi
  return 1
}

