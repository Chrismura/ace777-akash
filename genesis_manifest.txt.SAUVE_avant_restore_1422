# curl tolérant — 3 tentatives, pause 5s, ne tue jamais le processus (set -e safe)
curl_with_retry() {
  local attempt=1 max pause out rc
  max="$(to_int "${CURL_RETRY_MAX:-3}")"
  pause="$(to_int "${CURL_RETRY_PAUSE_SEC:-5}")"
  [ "$max" -lt 1 ] && max=1
  while [ "$attempt" -le "$max" ]; do
    set +e
    out="$(curl -sS --connect-timeout 10 --max-time 25 "$@" 2>&1)"
    rc=$?
    set -e
    if [ "$rc" -eq 0 ]; then
      printf '%s' "$out"
      return 0
    fi
    echo "${C_Y}NET_RETRY${C_N} ${C_N}| attempt=${attempt}/${max} rc=${rc}${C_N}" >&2
    if [ "$attempt" -lt "$max" ]; then
      sleep "$pause"
    fi
    attempt=$((attempt + 1))
  done
  echo "${C_Y}NET_RETRY_EXHAUSTED${C_N} ${C_N}| skip request (no process kill)${C_N}" >&2
  return 0
}

