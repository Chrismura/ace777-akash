  ' -- "$DUO_STATE_FILE" "$DUO_ROLE" "$status" "$side" "$bps" "$pnl_usdt" "$reason" "$cycle" "$hold_sec" >/dev/null 2>&1 || true
}

# P2 : rafraîchit ts_ms du duo_state sans changer le reste (évite stale_state entre trades SCOUT)
