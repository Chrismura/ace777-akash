    min_conf="${RADAR_MIN_CONF_ALPHA:-$RADAR_MIN_CONF}"
    min_mom="${RADAR_MIN_MOM_BPS_ALPHA:-$RADAR_MIN_MOM_BPS}"
  elif duo_is_scout; then
    min_conf="${RADAR_MIN_CONF_BETA:-$RADAR_MIN_CONF}"
    min_mom="${RADAR_MIN_MOM_BPS_BETA:-$RADAR_MIN_MOM_BPS}"
  fi
  if [ "$VORTEX_V2_RADAR_PILOT" = "TRUE" ] && [ "$VORTEX_CONTROL_ENABLED" = "TRUE" ]; then
    if duo_is_hunter && [ -n "$cycle_radar_min_conf_alpha" ]; then
      min_conf="$cycle_radar_min_conf_alpha"
      min_mom="$cycle_radar_min_mom_alpha"
    elif duo_is_scout && [ -n "$cycle_radar_min_conf_beta" ]; then
      min_conf="$cycle_radar_min_conf_beta"
      min_mom="$cycle_radar_min_mom_beta"
    fi
    [ -n "$cycle_radar_max_spread_bps" ] && max_spread="$cycle_radar_max_spread_bps"
    [ -n "$cycle_vortex_mode" ] && [ "$cycle_vortex_mode" != "OFF" ] && vortex_mode="$cycle_vortex_mode"
    min_conf="$(vortex_radar_clamp "$min_conf" "0.15" "0.45")"
    min_mom="$(vortex_radar_clamp "$min_mom" "0.003" "0.02")"
    max_spread="$(vortex_radar_clamp "$max_spread" "4.0" "16.0")"
    if [ "$cycle_hunter_scout_win_boost" = "1" ] && duo_is_hunter; then
      min_conf="$(vortex_radar_clamp "$(num_mul "$min_conf" "0.85")" "0.15" "0.45")"
      min_mom="$(vortex_radar_clamp "$(num_mul "$min_mom" "0.80")" "0.003" "0.02")"
    fi
  fi
  if [ "$SWARM_COUPLING_ENABLED" = "TRUE" ]; then
    if num_lt "$cycle_swarm_mom_mult" "1.0"; then
      min_mom="$(vortex_radar_clamp "$(num_mul "$min_mom" "$cycle_swarm_mom_mult")" "0.003" "0.02")"
