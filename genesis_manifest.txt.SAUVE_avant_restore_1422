check_radar() {
  local mom_bps="$1" spread_bps="$2"
  local min_conf="$RADAR_MIN_CONF"
  local min_mom="$RADAR_MIN_MOM_BPS"
  local max_spread="$RADAR_MAX_SPREAD_BPS"
