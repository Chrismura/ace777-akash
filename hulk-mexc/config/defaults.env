# Seuils inventaire / paper (pas de secrets ici)
WATCHLIST_URL=https://coinmarketcap.com/watchlist/68f096217962d710267cb472/
WATCHLIST_NAME=The_Hulk_Crypto_Portfolio_Picks

# Liquidité MEXC spot USDT
MIN_QUOTE_VOL_USDT=50000
MAX_SPREAD_BPS=80

# Paper v1.4 — pleine mise
NOTIONAL_USDT=20
# Realisme baissier : au démarrage, déjà ~20$ en tokens (paper) pour pouvoir VENDRE
SEED_ON=1
# Inventaire paper pour tester les VENTES baissières (~20$ en tokens).
# Ce n’est PAS le capital de trading (NOTIONAL_USDT=20 reste à part).
SEED_USDT=150
# split = répartir sur N paires ; single = 1 seule paire
SEED_MODE=split
# TEST 16/08 (GO Christophe) : seed le PORTEFEUILLE ENTIER — 15 paires × ~10$ = 150$ paper.
# On est en paper/test : on observe le comportement de tout l'univers, pas 2 paires seulement.
SEED_MAX_PAIRS=17
POLL_SEC=20
# Phase 2 (31/08) : refresh des régimes (klines 360 bougies × paires = ~42 appels)
# toutes les 10 cycles (~3 min) au lieu de 3 (~1 min). Le prix lui est à jour à
# chaque cycle via le batch ; les régimes ne changent pas à la seconde près.
SCORE_EVERY=10
# Veille LIVE : live = enchaîne les scans sans pause (délai = durée scan MEXC).
# Écrit VEILLE_ALERT seulement si signal nouveau.
DIGEST_LOOP_SEC=live
# Dédup : 1 écriture max / paire:type de hint par heure (VEILLE_CALLS / notes)
HINT_COOLDOWN_SEC=3600
# Veille robuste au réseau (WiFi/alpage) — deadline max d'un scan complet (fix 15/08)
# (timeout HTTP 12s + back-off + circuit-breaker 3 échecs/60s sont codés en dur dans digest_watch.py)
SCAN_DEADLINE_SEC=90
# Kill-switch global : veille muette (DIGEST_LATEST.md) > X heures → STANDBY (plus de nouvel achat)
VEILLE_STALE_HOURS=6
# Contrat Cortana ↔ moteur : ADVISORY = propositions loggées, JAMAIS appliquées tant que justesse < 60%
CORTANA_MODE=ADVISORY
CORTANA_PILOT_FILE=strategie/cortana_pilot.json
# === 2 classes de paires (famille 15/08) ===
# Classe B = small caps bag (institutionnel sous-radar) : taille réduite, PAS de stop technique, filtres assouplis
# (premier bag actif : CCUSDT = Canton, vérifié 15/08)
# RÈGLE GO (16/08 Christophe) : NE JAMAIS retirer une paire sans GO explicite.
# EDEL = small cap high-potentiel, bag/escalier (racheter après bear, vendre par paliers au sommet).
BAG_PAIRS=CCUSDT,EDELUSDT
BAG_MAX_POSITIONS=5
BAG_POSITION_MULT=0.5
BAG_NO_TECH_STOP=1
# === tier/rip (famille 16/08) : garde-fous typologie ===
# Tier B (illiquide, PLAN.md « paper ou taille microscopique ») : taille ×0.25
TIER_B_POSITION_MULT=0.25
# Pas de rip (vente rebond) sur tier B si spread > 100 bps (slippage)
TIER_B_SPREAD_MAX_BPS=100
# Garde spread au buy, même tier A (paires mal classées type QAIT 327 bps)
BUY_SPREAD_MAX_BPS=100
# RIP : vendre le rebond (PLAN.md) — 50% au 1er franchissement du rip_pct, une seule fois
RIP_SELL_FRAC=0.50
# === 16/08 soir (Christophe) : RIP scale-out 2 paliers — « une pierre trois coups » ===
# Vente partielle progressive : chaque palier vend ~25% → runner garde le reste pour le gros mouvement.
# XRP/HBAR (liquides, gros volumes) : vente TÔT — palier 1 à +2%, palier 2 à +6%.
# Reste (small caps) : palier 1 à +6%, palier 2 à +8% (laisser courir les pumps d'altsaison).
RIP_EARLY_PAIRS=XRPUSDT,HBARUSDT
RIP_EARLY_P1_PCT=2.0
RIP_EARLY_P2_PCT=6.0
RIP_LATE_P1_PCT=6.0
RIP_LATE_P2_PCT=8.0
# Fraction de la quantité INITIALE vendue à CHAQUE palier (2 paliers → 50% vendu, runner 50%)
RIP_SCALEOUT_FRAC=0.25
# === SPEC v2 SELL FULL (29/08, GO Christophe) : garde-fou amplitude + cascade partielle ===
# Coupe 100% interdite en forte amplitude (move24 > garde) sans invalidation confirmée : on passe en
# vente partielle 50% (cascade par paliers). Dust sweeper liquide les résidus < 1$ ou < min_qty.
SELL_FULL_AMPLITUDE_GUARD=12.0
SELL_FULL_REQUIRE_INVALIDATION=1
SELL_FULL_GUARD_DEGRADED=1
DUST_SWEEP_MIN_NOTIONAL=1.0
SELL_PARTIAL_CASCADE=1
# Re-entry borné : max 1 reprise après stop + cooldown
REENTRY_MAX=1
STOP_COOLDOWN_HOURS=4
# Bag de départ désactivé (16/08 GO Christophe) : le seed inventaire couvre déjà les 15 paires.
SEED_BAGS_ON=0
SEED_BAGS_USDT=10
SEED_BAGS_ENTRY_DD_PCT=8
SEED_BAGS_PAIRS=CCUSDT

# Régimes (15j / impulse) — strict : pas de micro-dips
QUIET_RANGE_PCT=8
SPIKE_15D_PCT=25
IMPULSE_PCT=8
COOLING_DD_MIN_PCT=8
COOLING_PULLBACK_FRAC=0.28
IMPULSE_PULLBACK_MIN_PCT=5
IMPULSE_PULLBACK_FRAC=0.30

# Cadence → seuils (floors + mult × cadence journalière médiane)
DIP_FLOOR_PCT=4.0
RIP_FLOOR_PCT=2.0
STOP_FLOOR_PCT=6.0
DIP_CADENCE_MULT=0.50
RIP_CADENCE_MULT=0.35
STOP_CADENCE_MULT=0.80

# === Logique mise → 2× → bag (plus de bag 15%) ===
# Mise 20$ → quand la position vaut 40$ (2×) → vend 50% (récupère ~mise)
# Reste = BAG maison (plus-value)
STAKE_DOUBLE_MULT=2.0
STAKE_SELL_FRAC=0.50

# Bag maison
BAG_DCA_ON=1
BAG_SLOW_DD_PCT=8
BAG_DCA_DD_PCT=6
BAG_DCA_TTL_SEC=86400
BAG_CRASH_DD_PCT=20
BAG_CRASH_SELL_FRAC=0.90

# Cash récupéré → redeploy 100% si dip (COOLING/IMPULSE)
CASH_REDEPLOY_ON=1

# Volume sniffer (priorité small-caps)
VOL_SMALL_CAP_USDT=400000
VOL_SMALL_CADENCE=12
VOL_SPIKE_MIN_SMALL=1.5
VOL_HOT_SPIKE=2.0
VOL_OK_SPIKE=1.3
VOL_DRY_SPIKE=0.8

# Compound : PnL réalisé grossit la taille des prochains trades
COMPOUND_ON=1
COMPOUND_FRAC=0.50
COMPOUND_MAX_MULT=3.0

# Re-entry : après SELL stop, racheter si dump
REENTRY_ON=1
REENTRY_DD_PCT=6
REENTRY_TTL_SEC=7200

# v1.5 — anti-reentry dur (cache stops) + skip RED veille (soft)
# 16/08 famille : cooldown passé à 4h (EDEL racheté 3× en chute) — voir REENTRY_MAX ci-dessus
STOP_COOLDOWN_HOURS=4
VEILLE_SKIP_RED_ON=1
VEILLE_STATUS_MAX_AGE_MIN=30
VEILLE_STATUS_REFRESH_SEC=60

# Capteurs style ACE (MEXC book) — pas le genesis
SENSE_ON=1
# Phase 2 (31/08) : carnet (book_sense) en cache TTL — 1 lecture / paire / 45s
# (rotation) au lieu d'un appel depth par paire à chaque cycle.
SENSE_CACHE_TTL_SEC=45
SENSE_MAX_SPREAD_BPS=80
SENSE_MAX_SPREAD_BPS_SPIKE=400
SENSE_MIN_DEPTH_USDT=80
SENSE_MIN_TENSION=1.2
SENSE_MAX_ASK_WALL_RATIO=8
SENSE_STRICT_TENSION=1

# === Sonde aspiration (16/08, mode OBSERVATION 48h) ===
# Inspiration ACE V8 : double lecture du carnet → chute des murs (verre d'eau = le vide attire).
# Consensus codeur 4/4 + famille 6/6 + Cortana : LOG + radar + CSV calibration, ZÉRO effet sur
# les entrées pendant l'observation. Fail-open (timeout MEXC → lecture simple, jamais de blocage).
# Corrections intégrées : drop normalisé par temps réel (GROK), mur ≥ 500$ (JUGE),
# croisement spread_delta (JUGE+DEEPSEEK), spoof « rétractable à maintenant » (Christophe/Cortana).
ASPIRATION_ON=1
# Phase 3 (31/08) : source de l'aspiration/murs. "fichier" (défaut) = le cœur
# LIT runs/aspiration_live.json écrit par satellite_aspiration.py (zéro appel
# depth dans le cœur). "inline" = comportement historique (le cœur sonde lui-même).
ASPIRATION_SRC=fichier
# Délai entre les 2 lectures du carnet (deepseek/codestral: 0.5s — gemini/nvidia: 1s → 0.5 retenu)
ASPIRATION_DELAY_S=0.5
# Filtre mur ≥ X$ DÉSACTIVÉ (16/08 Christophe : « je le voulais pas, pas utile ») —
# on mesure TOUS les murs, la taille se verra dans le CSV, pas de filtre arbitraire.
ASPIRATION_MIN_NOTIONAL_USDT=0
# Probe à CHAQUE cycle (16/08 Christophe : « on peut regarder le marché plus vite ? » →
# 3× plus d'échantillons en 48h, ~0.5 req/s — rien pour MEXC). Max paires actives par probe.
ASPIRATION_PROBE_EVERY=1
ASPIRATION_MAX_PAIRS=5
# Détecteur accumulation 24h (28/08, Christophe — OBSERVATION SEULE, aucun trade).
# Thèse : descente ≥ 2% (30 min) + prise du mur SUD (bid) → +24h win 58%, R:R 3.7
# (échantillon 12j concentré sur 2 jours haussiers → à confirmer en observation).
# Journalise runs/accumulation_signal.jsonl avec suivi +6h/+24h. ZÉRO effet moteur.
ACCUM_DESCENTE_PCT=2.0
ACCUM_DROP_PCT_S=5.0
ACCUM_MUR_USDT=2000
ACCUM_MEMO_SEC=1800
# Seuil spoof (%/s) — valeur de DÉPART, à calibrer sur les données 48h (loggé dans le CSV)
ASPIRATION_SPOOF_DROP_PCT_S=15
# Corrélation BTC (16/08 Christophe) : BTCUSDT lu 1× par probe, loggé à côté de chaque
# mesure → dans 48h, séparer « vrai signal » de « bruit entraîné par BTC » (small caps
# très sensibles aux mouvements de BTC, ex. RED +34% aujourd'hui).
ASPIRATION_BTC_ON=1

