PAPER_PAIRS=BTCUSDT,ETHUSDT,XRPUSDT,HBARUSDT,RIZEUSDT,ZBCNUSDT,WUSDT,REDUSDT,CCUSDT,PYTHUSDT,BIOUSDT,KITEUSDT,TELUSDT,CHIPUSDT,RWAINCUSDT,EDELUSDT,QNTUSDT,FLUIDUSDT,RWAUSDT,MNSRYUSDT
