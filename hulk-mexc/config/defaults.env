# Inventaire paper pour tester les VENTES baissières (~20$ en tokens).
# Ce n’est PAS le capital de trading (NOTIONAL_USDT=30 reste à part).
SEED_USDT=150
# split = répartir sur N paires ; single = 1 seule paire
SEED_MODE=split
# TEST 16/08 (GO Christophe) : seed le PORTEFEUILLE ENTIER — 15 paires × ~10$ = 150$ paper.
# On est en paper/test : on observe le comportement de tout l'univers, pas 2 paires seulement.
SEED_MAX_PAIRS=17
POLL_SEC=20
# Phase 2 (31/08) : refresh des régimes (klines 360 bougies × paires = ~42 appels)
# toutes les 10 cycles (~3 min) au lieu de 3 (~1 min). Le prix lui est à jour à
# chaque cycle via le batch ; les régimes ne changent pas à la seconde près.
SCORE_EVERY=10
# Veille LIVE : live = enchaîne les scans sans pause (délai = durée scan MEXC).
# Écrit VEILLE_ALERT seulement si signal nouveau.
DIGEST_LOOP_SEC=live
# Dédup : 1 écriture max / paire:type de hint par heure (VEILLE_CALLS / notes)
HINT_COOLDOWN_SEC=3600
# Veille robuste au réseau (WiFi/alpage) — deadline max d'un scan complet (fix 15/08)
# (timeout HTTP 12s + back-off + circuit-breaker 3 échecs/60s sont codés en dur dans digest_watch.py)
SCAN_DEADLINE_SEC=90
# Kill-switch global : veille muette (DIGEST_LATEST.md) > X heures → STANDBY (plus de nouvel achat)
VEILLE_STALE_HOURS=6
# Contrat Cortana ↔ moteur : ADVISORY = propositions loggées, JAMAIS appliquées tant que justesse < 60%
CORTANA_MODE=ADVISORY
CORTANA_PILOT_FILE=strategie/cortana_pilot.json
# === 2 classes de paires (famille 15/08) ===
# Classe B = small caps bag (institutionnel sous-radar) : taille réduite, PAS de stop technique, filtres assouplis
# (premier bag actif : CCUSDT = Canton, vérifié 15/08)
# RÈGLE GO (16/08 Christophe) : NE JAMAIS retirer une paire sans GO explicite.
# EDEL = small cap high-potentiel, bag/escalier (racheter après bear, vendre par paliers au sommet).
BAG_PAIRS=CCUSDT,EDELUSDT
BAG_MAX_POSITIONS=5
BAG_POSITION_MULT=0.5
BAG_NO_TECH_STOP=1
# === tier/rip (famille 16/08) : garde-fous typologie ===
# Tier B (illiquide, PLAN.md « paper ou taille microscopique ») : taille ×0.25
TIER_B_POSITION_MULT=0.25
# Pas de rip (vente rebond) sur tier B si spread > 100 bps (slippage)
TIER_B_SPREAD_MAX_BPS=100
# Garde spread au buy, même tier A (paires mal classées type QAIT 327 bps)
BUY_SPREAD_MAX_BPS=100
# RIP : vendre le rebond (PLAN.md) — 50% au 1er franchissement du rip_pct, une seule fois
RIP_SELL_FRAC=0.50
# === 16/08 soir (Christophe) : RIP scale-out 2 paliers — « une pierre trois coups » ===
# Vente partielle progressive : chaque palier vend ~25% → runner garde le reste pour le gros mouvement.
# XRP/HBAR (liquides, gros volumes) : vente TÔT — palier 1 à +2%, palier 2 à +6%.
# Reste (small caps) : palier 1 à +6%, palier 2 à +8% (laisser courir les pumps d'altsaison).
RIP_EARLY_PAIRS=XRPUSDT,HBARUSDT
RIP_EARLY_P1_PCT=2.0
RIP_EARLY_P2_PCT=6.0
RIP_LATE_P1_PCT=6.0
RIP_LATE_P2_PCT=8.0
# === 22/09/2026 (R17) : le palier est relu dans l'unité MESURÉE de la paire (sa cadence) ===
# Mesuré sur 119 entrées RÉELLES à 2 horizons (chiffrage_sortie_mesuree.py) : +2,22 $ et
# +1,05 $ (même signe), pire trade INCHANGÉ, pertes suppl. +0,69 $ payées 4,7× par +3,27 $.
# La forme symétrique (sans plancher) a été MESURÉE PUIS REJETÉE (signe instable).
# RÈGLE, une seule grandeur mesurée : palier = palier_fixe × max(1 ; cadence_paire / cadence_réf).
# - le PLANCHER existe : si la paire bouge MOINS que la référence, elle garde le palier actuel
#   (aucune protection retirée) ; si elle bouge PLUS, son palier s'élargit à sa mesure.
# - la cadence est MESURÉE par le moteur à chaque cycle (médiane des ranges 15 j) — elle est
#   déjà journalisée colonne `cadence` ; la référence n'est qu'une ÉCHELLE, pas une garde.
# Cadence de référence = MÉDIANE des paires réellement tradées, mesurée le 22/09/2026 sur
# 119 entrées (2,34 %/j mini · 7,30 %/j médiane · 49 %/j maxi). À RE-MESURER si l'univers change.
RIP_CADENCE_MESURE_ON=1
RIP_CADENCE_REF_PCT=7.30
