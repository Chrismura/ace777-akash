# =============================================================================
# ACE777 — CONFIG ACTIVE (source unique de vérité)
# Profil : VIDE FROID BINANCE (canonique 2026-07-08)
# Usage : source ./config_active.env  (en tête de chaque lanceur)
# Override ponctuel : source ./config_profiles/<nom>.env après ce fichier
# =============================================================================

export ACE777_CONFIG_NAME="vide_froid_binance"
export ACE777_CONFIG_VERSION="2026-07-08-setup-ready"

# --- Identité run (surchargé par le lanceur) ---
export RUN_DURATION="${RUN_DURATION:-04:00:00}"
export CYCLE_COLORS="${CYCLE_COLORS:-TRUE}"

# --- Masse duo (NE PAS MODIFIER sans ordre explicite) ---
export BUY_USDT_BETA=200
export BUY_USDT_ALPHA=800

# --- Signal & risque (fortress) ---
export MOMENTUM_THRESHOLD="${MOMENTUM_THRESHOLD:-0.96}"
export WALL_DROP_THRESHOLD="${WALL_DROP_THRESHOLD:-0.065}"
export GLOBAL_STOP_USDT="${GLOBAL_STOP_USDT:--45.00}"
export ALPHA_REVENGE_MULT="${ALPHA_REVENGE_MULT:-2.5}"
export STOP_LOSS_BPS="${STOP_LOSS_BPS:-16}"
export FLUID_EXIT_SENSITIVITY="${FLUID_EXIT_SENSITIVITY:-1.0}"
export LEVERAGE="${LEVERAGE:-5}"

# --- Hedge mode ---
export POSITION_SIDE_STRICT=TRUE
export BINANCE_HEDGE_MODE=TRUE

# --- LLM gate (fail-closed depuis 2026-07-08) ---
export LLM_GATE_ENABLED=TRUE
export LLM_GATE_FAIL_CLOSED=TRUE
export LLM_GATE_CONNECT_TIMEOUT=2
export LLM_GATE_MAX_TIME=3
export LLM_MODEL=qwen2.5-coder:1.5b
export LLM_OLLAMA_URL=http://127.0.0.1:11434

# --- Vide Froid — entrée progressive (Binance min 100 USDT) ---
export ENTRY_25_75_ENABLED=TRUE
export ENTRY_25_75_INITIAL_FRACTION_BETA=0.70
export ENTRY_25_75_INITIAL_FRACTION_ALPHA=0.50
export ENTRY_25_75_CONFIRM_MS=250
export ENTRY_25_75_FLUX_MIN_BPS=-5

# --- Vide Froid — shock exit (miroir filtre entrée BASE 16) ---
export SHOCK_EXIT_10_BPS_ENABLED=TRUE
export SHOCK_EXIT_10_BPS=16

# --- Vide Froid — stase dynamique (aspiration BASE 16) ---
export STASE_DYNAMIQUE_ENABLED=TRUE
export VOLATILITY_FILTER=16
export STASE_DYNAMIQUE_MAX_SPREAD_BPS=16
export STASE_DYNAMIQUE_MAX_VOLATILITY=16

# --- Latence M1 BASE 16 (64ms) ---
export POLL_SEC=0.064
export VOLATILITY_IMPULSE_DT_MS=64
export IMPULSE_RESONANCE_DT_MS=64

# --- Pilotage runtime ---
export RUN_STATE_ENABLED=TRUE
export RUN_STATE_LINK_TOTAL_PNL=TRUE

# --- Duo SCOUT/HUNTER (fix ALPHA dormante 2026-07-08) ---
# P0 : revenge sur toute fermeture perdante (pas seulement stop_loss)
export DUO_HUNTER_REQUIRE_STOP_LOSS=FALSE
# P1 : TTL état scout élargi (réduit stale_state)
export DUO_EVENT_TTL_SEC=60

# --- Radar (P3 : ALPHA légèrement plus permissif que BETA) ---
export RADAR_GATE=TRUE
export RADAR_MIN_CONF_BETA=0.30
export RADAR_MIN_MOM_BPS_BETA=0.01
export RADAR_MIN_CONF_ALPHA=0.25
export RADAR_MIN_MOM_BPS_ALPHA=0.008
export RADAR_DIR_BPS=0.20
export RADAR_MAX_SPREAD_BPS=8

# --- Vortex supervisor (OFF pour vide froid canonique) ---
export VORTEX_CONTROL_ENABLED=FALSE
export VORTEX_CHOP_RADAR=0.85
export VORTEX_TREND_RADAR=0.618
export VORTEX_CHOP_MOM=0.95
export VORTEX_TREND_MOM=0.85
