# Profil override — Vide Froid classique (stase 5bps, confirm 500ms, shock 10bps)
# Usage : source config_active.env && source config_profiles/vide_froid_classic.env
export ACE777_CONFIG_NAME="vide_froid_classic"
export ENTRY_25_75_CONFIRM_MS=500
export SHOCK_EXIT_10_BPS=10
export STASE_DYNAMIQUE_MAX_SPREAD_BPS=5
export STASE_DYNAMIQUE_MAX_VOLATILITY=0.5
unset VOLATILITY_FILTER
