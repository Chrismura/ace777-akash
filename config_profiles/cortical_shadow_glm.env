# Phase C — superviseur cortical GLM-5.2 (mode shadow uniquement)
# Ne modifie PAS vortex_control.json live.

export CORTICAL_SHADOW_FILE="runs/vortex_control.json.shadow"
export CORTICAL_INTERVAL_SEC=20
export CORTICAL_TAIL_LINES=30
export CORTICAL_LLM_BUDGET_SEC=8.0

# Provider: openrouter (défaut) ou zai
export GLM_PROVIDER=openrouter
export GLM_MODEL=z-ai/glm-5.2

